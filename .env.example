# --- OpenAI Realtime API ---
# Clave secreta de OpenAI. NUNCA se expone al navegador: el servidor solo emite
# tokens efimeros de corta duracion para que el navegador conecte por WebRTC.
OPENAI_API_KEY=sk-...

# Modelo Realtime a usar (configurable por si cambia el nombre en tu cuenta).
OPENAI_REALTIME_MODEL=gpt-realtime

# Voz por defecto del profesor.
OPENAI_REALTIME_VOICE=marin

# Endpoints de la Realtime API (GA). Cambialos solo si tu cuenta usa otros.
OPENAI_CLIENT_SECRETS_URL=https://api.openai.com/v1/realtime/client_secrets
OPENAI_REALTIME_CALLS_URL=https://api.openai.com/v1/realtime/calls

# Modelo de texto para herramientas auxiliares (recomendaciones, generacion de agentes).
OPENAI_TEXT_MODEL=gpt-4.1

# --- Orquestador de agentes privados (integracion real con Vercel) ---
# Token de Vercel con permiso de despliegue. Si esta vacio, el orquestador
# funciona en modo SIMULACION (genera la spec y un subdominio temporal ficticio).
VERCEL_TOKEN=
# Opcional: id del equipo de Vercel donde desplegar.
VERCEL_TEAM_ID=

# --- Servidor ---
PORT=3000
# Dominio base bajo el que se asignan los agentes temporales (informativo).
PROFIA_TEMP_DOMAIN=prof-ia.app
